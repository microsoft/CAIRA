# terraform.tfvars.example - - Example values file

# Required: Reference to existing AI Hub resources
ai_hub_resource_group = "rg-ai-foundry-prod"

# These can be automatically discovered if you use the import script
# Or manually specify them:
ai_hub_name                 = "hub-caira-prod-abc12345"
ai_project_name              = "project-caira-prod-abc12345"
key_vault_name               = "kv-caira-prod-abc12345"
application_insights_name    = "appi-caira-prod-abc12345"
ai_hub_storage_account_name  = "stcairaabc12345"

# Optional: Use the same suffix as AI Hub for consistency
use_existing_suffix = true
existing_suffix     = "abc12345"

# Function App configuration
environment    = "dev"
project_name   = "caira"
function_app_sku = "EP1"  # Elastic Premium for production

# Optional: Restrict access to specific IPs
allowed_ip_ranges = [
  "192.168.1.0/24",  # Office network
  "10.0.0.0/16"      # VPN range
]

# Optional: CORS settings
cors_allowed_origins = [
  "https://myapp.azurewebsites.net",
  "https://localhost:3000"
]

tags = {
  Owner       = "AI Team"
  CostCenter  = "Engineering"
  Environment = "Production"
}
